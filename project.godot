; Engine configuration file.
; Este arquivo é editado pelo Claude. Não é preciso abrir o editor Godot.

config_version=5

[application]

config/name="Na Lata"
config/description="Hub de jogos Na Lata. Primeiro jogo: Poção de Cores."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.08, 0.25, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Ads="*res://scripts/autoload/ads.gd"
Server="*res://scripts/autoload/server.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/nalata_android/plugin.cfg")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
